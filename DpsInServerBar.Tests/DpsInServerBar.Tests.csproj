<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of the plugin's pure logic (no game needed). Not in the solution, so releases do not build it:
       run with "dotnet test DpsInServerBar.Tests". -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DpsInServerBar\DpsInServerBar.csproj" />
  </ItemGroup>
</Project>
